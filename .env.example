# Copy to .env and fill in. Placeholders only — never commit real values.
#
# Credentials are obtained through managed identity, so there is no key or secret here
# for Azure access. The one secret present is the diagnostics token, which protects a
# route that causes real outbound traffic.

# --- The two business destinations -------------------------------------------------
# Must be distinct hostnames and must both be https. The policy API host goes on the
# egress allowlist; the receiver host is deliberately left off it.
DEMO_POLICY_API_URL=https://REPLACE-policy-api.REPLACE.azurecontainerapps.io/policy
DEMO_TEST_RECEIVER_URL=https://REPLACE-test-receiver.REPLACE.azurecontainerapps.io/ingest

# --- HTTP behaviour -----------------------------------------------------------------
DEMO_HTTP_TIMEOUT_SECONDS=10

# --- Evidence labelling ---------------------------------------------------------------
# An evidence label only. Nothing in the application branches on it; setting it wrong
# mislabels a run's evidence but cannot change the application's behaviour.
# One of: local | audit | enforced
DEMO_POLICY_MODE=local

# Correlation marker. Leave unset to get a fresh one per process, or set it to tie a
# scripted run together across the agent, the platform and the two endpoints.
# DEMO_DEMO_RUN_ID=run-00000000-0000-0000-0000-000000000000

# --- Model access ---------------------------------------------------------------------
# Must match infra/cloud var.model_name.
DEMO_MODEL_DEPLOYMENT=gpt-5.4-mini
DEMO_AZURE_OPENAI_ENDPOINT=https://REPLACE.openai.azure.com/
DEMO_AZURE_OPENAI_API_VERSION=2024-10-21

# --- Diagnostics ------------------------------------------------------------------------
# Minimum 16 characters. Startup fails if diagnostics are enabled without one; there is
# no unauthenticated mode.
DEMO_DIAGNOSTICS_ENABLED=true
DEMO_DIAGNOSTICS_TOKEN=REPLACE-with-a-long-random-value

# --- Telemetry --------------------------------------------------------------------------
# Only used outside the hosted runtime. Inside the container the agent server host owns
# telemetry configuration and this is ignored.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=REPLACE;IngestionEndpoint=https://REPLACE
