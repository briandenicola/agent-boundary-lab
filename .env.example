# Copy to .env and fill in. Placeholders only — never commit real values.
#
# Runtime Azure credentials use managed identity. The optional I0 directory check
# references an operator certificate file; no private key belongs in this file.
# The diagnostics token protects a route that causes real outbound traffic.

# --- The two business destinations -------------------------------------------------
# Must be distinct hostnames and must both be https. The policy API host goes on the
# egress allowlist; the receiver host is deliberately left off it.
DEMO_POLICY_API_URL=https://REPLACE-policy-api.REPLACE.azurecontainerapps.io/policy
DEMO_TEST_RECEIVER_URL=https://REPLACE-test-receiver.REPLACE.azurecontainerapps.io/ingest

# --- HTTP behaviour -----------------------------------------------------------------
DEMO_HTTP_TIMEOUT_SECONDS=10

# --- Evidence labelling ---------------------------------------------------------------
# An evidence label only. Nothing in the application branches on it; setting it wrong
# mislabels a run's evidence but cannot change the application's behaviour.
# One of: local | audit | enforced
DEMO_POLICY_MODE=local

# Correlation marker. Leave unset to get a fresh one per process, or set it to tie a
# scripted run together across the agent, the platform and the two endpoints.
# DEMO_DEMO_RUN_ID=run-00000000-0000-0000-0000-000000000000

# --- Opt-in I0 directory lifecycle check ----------------------------------------------
# Dedicated admin-consented Graph deployer; not runtime agent credentials.
# The PEM contains its certificate and private key: keep it untracked and owner-only.
# No Azure CLI token or client-secret fallback. See docs/identity-probe.md.
# IDENTITY_TENANT_ID=REPLACE-tenant-uuid
# IDENTITY_GRAPH_CLIENT_ID=REPLACE-dedicated-graph-application-uuid
# IDENTITY_SPONSOR_USER_ID=REPLACE-synthetic-sponsor-user-uuid
# IDENTITY_GRAPH_CERTIFICATE_PATH=/REPLACE/private/graph-deployer.pem

# --- Model access ---------------------------------------------------------------------
# Must match infra/cloud var.model_name.
DEMO_MODEL_DEPLOYMENT=gpt-5.4-mini
DEMO_AZURE_OPENAI_ENDPOINT=https://REPLACE.openai.azure.com/
DEMO_AZURE_OPENAI_API_VERSION=v1

# --- Diagnostics ------------------------------------------------------------------------
# Minimum 16 characters. Startup fails if diagnostics are enabled without one; there is
# no unauthenticated mode.
DEMO_DIAGNOSTICS_ENABLED=true
DEMO_DIAGNOSTICS_TOKEN=REPLACE-with-a-long-random-value

# --- Telemetry --------------------------------------------------------------------------
# Only used outside the hosted runtime. Inside the container the agent server host owns
# telemetry configuration and this is ignored.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=REPLACE;IngestionEndpoint=https://REPLACE

# --- Agent deployment (containment_demo.deploy) -------------------------------------
# Only the in-VNet deploy Job reads these. The Foundry data plane has
# publicNetworkAccess disabled, so a laptop gets "(403) Public access is disabled";
# this runs on AKS under workload identity. All values are Terraform outputs.
DEMO_FOUNDRY_ACCOUNT_NAME=REPLACE-foundry-account
DEMO_FOUNDRY_PROJECT_NAME=REPLACE-project

# Digest-pinned, always. A tag is rejected at startup: it could be repointed between
# the two deployments, which would make the image a second uncontrolled variable
# alongside the policy. If the service refuses a digest, STOP — do not use a tag.
DEMO_AGENT_IMAGE=REPLACE.azurecr.io/containment-demo@sha256:REPLACE-64-hex-characters
# DEMO_REGISTRY_CONNECTION_ID=
DEMO_AGENT_CPU=1
DEMO_AGENT_MEMORY=2Gi
DEMO_AGENT_PROTOCOL=responses
DEMO_AGENT_PROTOCOL_VERSION=2.0.0

DEMO_AGENT_NAME_AUDIT=containment-demo-audit
DEMO_AGENT_NAME_ENFORCED=containment-demo-enforced

# Full ARM resource ids, not bare names. Terraform outputs rai_policy_audit_id and
# rai_policy_enforced_id. A bare name is rejected by the service (compatibility.md B4).
DEMO_RAI_POLICY_AUDIT_ID=/subscriptions/REPLACE/resourceGroups/REPLACE/providers/Microsoft.CognitiveServices/accounts/REPLACE/raiPolicies/REPLACE-audit
DEMO_RAI_POLICY_ENFORCED_ID=/subscriptions/REPLACE/resourceGroups/REPLACE/providers/Microsoft.CognitiveServices/accounts/REPLACE/raiPolicies/REPLACE-enforced

# A healthy hosted agent version reached Running in under a minute on 2026-10-08.
# 120s is four times that. A timeout is a FAILURE, never an optimistic pass.
DEMO_DEPLOY_TIMEOUT_SECONDS=120
DEMO_DEPLOY_POLL_SECONDS=3
DEMO_DEPLOY_REQUEST_TIMEOUT_SECONDS=15
# Kept low so SDK retries cannot consume the whole budget inside one call.
DEMO_DEPLOY_RETRY_TOTAL=2

# --- Operator-only: terraform inputs loaded by the root Taskfile -----------------------
# Explicit deployment target, checked against Azure CLI before cloud:plan/bootstrap/up.
# ARM_TENANT_ID=REPLACE-approved-deployment-tenant-uuid
# ARM_SUBSCRIPTION_ID=REPLACE-approved-deployment-subscription-uuid
# Optional extra AKS operators, in addition to the Terraform caller.
# Tenant-local Entra object IDs, not application/client IDs. JSON array syntax.
# TF_VAR_aks_operator_object_ids='["REPLACE-approved-operator-object-uuid"]'
#
# Image tags are immutable and git-derived: `<sha7>`, or `<sha7>-dirty-<UTC timestamp>` when
# the working tree has changes. There is NO `latest`. Each `task build:*` records its tag in
# .task/image-tags/ and the matching deploy tasks read it; a deploy with no record fails and
# names the build task to run. Leave these UNSET normally. Set one only to override the
# recorded tag with an existing immutable tag (the value `latest` is rejected).
# IMAGE_TAG=<sha7>                # foundry-agent and tool-apis
# A2A_IMAGE_TAG=<sha7>            # agent-bridge
# HARNESS_IMAGE_TAG=<sha7>        # chat-agent
# LOCAL_MODEL_IMAGE_TAG=<sha7>    # model-server
# UI_IMAGE_TAG=<sha7>             # test-ui
# Their matching *_IMAGE_DIGEST overrides still pin deployment to an explicit digest.
# AGENT_IMAGE_DIGEST pins the foundry-agent deployment; both versions use that same pin.
#
# Tag of the two controlled-endpoint images in ACR. Leave UNSET until
# `task build:tool-apis` has actually pushed them — on a first apply the images do not
# exist and the Container Apps must run the placeholder.
#
# `task build:tool-apis` upserts this line into .env automatically, so cloud:up keeps the
# endpoints on the built image instead of rolling them back to the placeholder.
# ENDPOINT_IMAGE_TAG=<sha7>

# Issue #4 policy API delegated auth. Set only the allowed user object ids (comma-separated,
# Entra user OBJECT ids, never hardcoded in terraform). `task app:deploy-external` writes the
# TF_VAR_policy_api_* lines into .env itself and runs `cloud:up` to apply them.
# Without those lines the policy API stays in legacy (unauthenticated) mode.
# POLICY_API_AUTHORIZED_USER_IDS=REPLACE-allowed-user-object-uuid

# --- External harness ingress (issue #4) ---------------------------------------------
# Consumed by task app:deploy-external / task chat-agent:external-bootstrap.
# EXTERNAL_HOSTNAME=demo.REPLACE.example.com
# LETSENCRYPT_EMAIL=ops@REPLACE.example.com
# Optional: show direct diagnostics links in the harness UI.
# HARNESS_WORKBOOK_URL=https://portal.azure.com/#view/Microsoft_Azure_Monitoring_Logs/WorkbookBlade/...
# HARNESS_LOGS_URL=https://portal.azure.com/#blade/Microsoft_Azure_Monitoring_Logs/LogsBlade/...
# HARNESS_APPINSIGHTS_URL=https://portal.azure.com/#resource/subscriptions/REPLACE/resourceGroups/REPLACE/providers/microsoft.insights/components/REPLACE/overview
# Optional: default app registration display name. If omitted:
# OIDC_APP_NAME=agent-boundary-harness-oidc
# Optional: explicit tenant for app registration (defaults to az account tenant).
# TENANT_ID=REPLACE-tenant-uuid
# Optional: set to 1 to rotate the OIDC client secret on the next external-app/bootstrap run.
# ROTATE_OIDC_SECRET=0
