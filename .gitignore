# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Local configuration — never commit real resource values or credentials
.env
.env.local

# Terraform — local state, per docs/compatibility.md this demo uses local state only
.terraform
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.*
terraform.tfstate.d
.terraform.tfstate.lock.info
*.tfvars
!*.tfvars.example
