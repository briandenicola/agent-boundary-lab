# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Local configuration — never commit real resource values or credentials
.env
.env.local

# Terraform — local state, per docs/compatibility.md this demo uses local state only
.terraform
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.*
terraform.tfstate.d
.terraform.tfstate.lock.info
*.tfvars
!*.tfvars.example

# Task's checksum store. Deleting it only costs one extra terraform init.
.task/

# Verification output. Evidence summaries are run artifacts, not source.
evidence/

# Rendered Kubernetes manifests. The committed manifests under deploy/kustomize/ carry
# REPLACE_WITH_* placeholders and are never mutated; the real values — including the
# diagnostics token and the App Insights connection string — exist only inside the
# `kustomize build | sed | kubectl` pipe. If anyone ever redirects that pipe to a file
# instead, this stops the file from being committed. Do not "fix" a lint failure by
# writing a rendered manifest into the tree.
deploy/**/rendered/
*.rendered.yaml
*.rendered.yml

# Kubeconfigs. Carry cluster credentials.
kubeconfig
kubeconfig.*
*.kubeconfig
