      "boundElements": [],
      "updated": 1760000000000,
      "link": null,
      "locked": false,
      "text": "Outbound containment is enforced by the platform, not the application. The egress policy is the only variable.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Outbound containment is enforced by the platform, not the application. The egress policy is the only variable.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text-1",
      "type": "text",
      "x": 321.6,
      "y": 620,
      "width": 796.8,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 619494263,
      "version": 1,
      "versionNonce": 1772792530,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1760000000000,
      "link": null,
      "locked": false,
      "text": "Only variable between the two versions: the egress policy mode (Audit vs Enforced).",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Only variable between the two versions: the egress policy mode (Audit vs Enforced).",
      "autoResize": true,
      "lineHeight": 1.25
    },
