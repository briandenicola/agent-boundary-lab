# Harness chat service image (compatibility.md B13/B14). Separate from the agent image, whose
# digest is the experiment's control, and from the demo UI image: the harness runs the ADK
# agent on LiteLLM (google-adk, litellm) and is an A2A client of the facades (a2a-sdk).
# No Azure SDK: it reaches Foundry only through the facades, and the model through
# LOCAL_MODEL_BASE_URL. The package is installed with --no-deps so the agent server stack
# (azure-ai-agentserver-*) is not pulled in; protobuf is capped below 7 as in the facade.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /usr/local/bin/uv

COPY pyproject.toml README.md* ./
COPY docs/README.md docs/README.md
COPY src ./src

RUN uv pip install --system --no-cache --no-deps . \
    && uv pip install --system --no-cache \
        "google-adk>=2.11.0,<3" "litellm>=1.0" \
        "pydantic>=2.9" "pydantic-settings>=2.6" "httpx>=0.27" \
        "a2a-sdk==1.0.2" "protobuf>=5.29.5,<7" "starlette>=0.40" "uvicorn[standard]>=0.32"

RUN useradd --create-home --uid 10001 harness
USER 10001

EXPOSE 8080

ENTRYPOINT ["python", "-m", "containment_demo.harness.chat"]
